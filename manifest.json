{
  "manifest_version": 3,
  "name": "自動領取 Play Points!",
  "description": "專為台灣介面打造，在電腦閒置期間 \"自動領取 Play Points!\" 🙂‍↕️",
  "version": "1.0",
  "permissions": ["idle", "storage", "tabs"],
  "host_permissions": ["https://play.google.com/store/points/perks"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/store/points/perks"],
      "js": ["content.js"]
    }
  ]
}